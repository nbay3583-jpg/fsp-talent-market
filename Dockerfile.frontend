FROM node:22-alpine AS build
WORKDIR /ui
COPY src/ui/package*.json ./
RUN npm install
COPY src/ui ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /ui/dist /usr/share/nginx/html
RUN printf 'server {\n listen 80;\n location /api/ { proxy_pass http://backend:8000/; }\n location / { root /usr/share/nginx/html; try_files $uri /index.html; }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
