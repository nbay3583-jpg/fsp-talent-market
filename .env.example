# Optional: docker compose runs without a .env (defaults are built in). To customise: cp .env.example .env
# Names and example values only - never commit a real .env.
POSTGRES_USER=fsp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fsp_market
DATABASE_URL=postgresql+psycopg://fsp:change-me@db:5432/fsp_market
# Signs bearer tokens. CHANGE for anything other than a local demo.
JWT_SECRET=change-me-long-random-string
ENVIRONMENT=local
# true: seeds demo accounts/data on start, enables /api/demo/* (demo login, reference answers).
# Must be false anywhere real candidates exist.
DEMO_MODE=true
# Core flow needs no LLM and no API keys.
