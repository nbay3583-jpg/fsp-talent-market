FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml alembic.ini ./
COPY src ./src
COPY artifacts ./artifacts
COPY constraints.txt ./
RUN pip install --no-cache-dir -c constraints.txt .
EXPOSE 8000
# migrate -> seed demo data (only when DEMO_MODE=true; idempotent) -> serve
CMD ["sh", "-c", "alembic upgrade head && python -m fsp_market.demo seed --if-demo-mode && uvicorn fsp_market.main:app --host 0.0.0.0 --port 8000"]
