# Template for docker-compose.deploy.yml. Copy to .env.deploy (untracked) and replace every REPLACE_ME.
POSTGRES_USER=fsp
POSTGRES_PASSWORD=REPLACE_ME_db_password
POSTGRES_DB=fsp_market
# Signs bearer tokens: use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=REPLACE_ME_long_random_secret
# Not "production"/"prod": the startup guard rejects DEMO_MODE=true there.
ENVIRONMENT=demo
# Public hackathon demo: seeds demo accounts/data, enables /api/demo/*. No real candidate data allowed.
DEMO_MODE=true
